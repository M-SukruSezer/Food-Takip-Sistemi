NODE_ENV=production
PORT=4000

# Supabase PostgreSQL connection string (Supavisor pooler)
# UYARI: db.<ref>.supabase.co dogrudan adresi yalnizca IPv6 uzerinden cozulur.
# IPv4 ortamlarinda (yerel makine, Vercel) pooler adresini kullanin.
#   Yerel / uzun omurlu sunucu (session mode) -> port 5432
#   Vercel / serverless (transaction mode)    -> port 6543
DATABASE_URL=postgresql://postgres.<project-ref>:replace-with-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# Uzun ve rastgele bir JWT anahtari kullanin
JWT_SECRET=replace-with-a-long-random-secret

# Demo veri olusturmaz; yalnizca yerel gelistirmede true yapin
SEED_DEMO_DATA=false

# Ilk kurulumda bos veritabanina yonetici olusturmak icin doldurun
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Ana Yonetici

# --- Push bildirimleri (Firebase Cloud Messaging) ---
# Sunucunun bildirim GONDEREBILMESI icin servis hesabi ozel anahtari gerekir.
# google-services.json BU ISI GORMEZ: o istemci yapilandirmasidir, uygulamanin
# FCM'e kaydolmasini saglar; gonderme yetkisi yoktur.
#
# Nereden alinir:
#   Firebase Konsolu -> Proje ayarlari -> Hizmet hesaplari
#   -> "Yeni özel anahtar oluştur" -> inen JSON dosyasi
#
# Dosyanin TAMAMI tek satir olarak buraya yapistirilir:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"saha-operasyon-takip",...}
#
# Alternatif olarak uc alan ayri verilebilir (private_key icindeki satir
# sonlari \n olarak yazilir):
# FIREBASE_PROJECT_ID=saha-operasyon-takip
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@saha-operasyon-takip.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# TANIMLI DEGILSE: push gonderimi sessizce devre disi kalir. Bildirimler
# veritabanina yazilmaya devam eder ve uygulama acikken yoklama yoluyla
# telefonda gorunur; yalnizca uygulama kapaliyken bildirim gitmez.
